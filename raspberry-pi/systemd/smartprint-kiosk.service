[Unit]
Description=GITAM SMARTPRINT Fullscreen HDMI Chromium Kiosk Display
# Wait for the graphical session to be available AND the network AND the agent
After=graphical-session.target network-online.target smartprint-agent.service
PartOf=graphical-session.target
Wants=network-online.target

[Service]
Type=simple
# Run as the desktop user (smartprint on Raspberry Pi 4)
User=smartprint
Group=smartprint
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/smartprint/.Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
# Deployed Vercel production kiosk URL
Environment=KIOSK_URL=https://smart-prints.vercel.app/kiosk/GITAM-SPK-001
ExecStartPre=/bin/sleep 5
ExecStart=/bin/bash /opt/smartprint/raspberry-pi/scripts/kiosk_setup.sh
Restart=always
RestartSec=8
# Kill chromium on service stop
KillMode=process
KillSignal=SIGTERM

[Install]
WantedBy=graphical-session.target

