# ===================================================================
# GITAM SMARTPRINT — Environment Variables
# ===================================================================
# NEVER commit actual values to git. Copy this to .env.local and fill in.
# ===================================================================

# ----------- Application -----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------- Firebase (Client-Side - REQUIRED) -----------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# ----------- Firebase Admin (Server-Side - REQUIRED for production) -----------
# JSON string of the Firebase service account key, or path to the JSON file
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# ----------- Super Admin Email -----------
# Email address of the platform super admin (used for bootstrapping)
SUPER_ADMIN_EMAIL=admin@gitam.edu

# ----------- Supabase (REQUIRED) -----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=smartprint-temporary

# ----------- Razorpay (REQUIRED for payments) -----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ----------- Raspberry Pi Agent -----------
SMARTPRINT_BACKEND_URL=https://your-deployed-app.vercel.app
SMARTPRINT_KIOSK_ID=GITAM-SPK-001
SMARTPRINT_DEVICE_TOKEN=generate-a-secure-random-token-here

# ----------- Admin Bootstrap (Development Only) -----------
# Set a strong, random token for local dev bootstrap. Remove in production.
# ADMIN_SECRET_TOKEN=change-this-to-a-strong-random-value
